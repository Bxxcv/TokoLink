# Salin file ini menjadi .env lalu isi dari Supabase dashboard
# (Project Settings → API). JANGAN taruh service_role key di file .env
# yang berawalan VITE_ — service role hanya untuk server functions.
VITE_SUPABASE_URL=https://xyzcompany.supabase.co
VITE_SUPABASE_ANON_KEY=isi-dengan-anon-key-dari-supabase-dashboard

# ---- SERVER ONLY (isi di Vercel > Settings > Environment Variables, JANGAN pakai awalan VITE_) ----
# SUPABASE_URL=https://xyzcompany.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=isi-dari-dashboard-supabase-settings-api
# BuatQris (dasbor BuatQris > Open API): JANGAN tempel nilai asli di file/repo/chat.
# BUATQRIS_ACCOUNT_ID=
# BUATQRIS_SECRET_TOKEN=
# BUATQRIS_SIGNING_SECRET=
# BUATQRIS_TEST=1  ("1" = sandbox tanpa uang asli; kosongkan untuk produksi)
# BUATQRIS_CALLBACK_URL=https://tokolink-kappa.vercel.app/api/buatqris-webhook
